# Copy to `.env` (git-ignored) and fill in locally or in CI secrets.
# Nothing in this file is read by the game until M7 (backend sync).

# Supabase project (M7). The anon key is a public client key protected by RLS;
# the service-role key must only ever live on the server / in CI secrets.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Path to the Godot 4.7.x binary used by tools/*.sh (optional; defaults to
# .tools/godot from tools/install_tools.sh, then `godot` on PATH).
GODOT_BIN=
