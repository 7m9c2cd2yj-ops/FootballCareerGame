# Copy to `.env` (git-ignored) and fill in locally or in CI secrets.
# See docs/SUPABASE_SETUP.md.

# Supabase project. tools/write_backend_config.sh turns these two into
# config/backend.local.json (git-ignored), which builds use for online
# features. The anon key is a public client key protected by row-level
# security. Never put the service-role key here or in the game: edge
# functions get it from Supabase automatically.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Path to the Godot 4.7.x binary used by tools/*.sh (optional; defaults to
# .tools/godot from tools/install_tools.sh, then `godot` on PATH).
GODOT_BIN=
